// --- OTLP RECEIVER ---
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
}

// --- METRICS ---
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.prometheus.receiver]
}

prometheus.remote_write "prometheus" {
  endpoint {
    url = "http://prometheus-server.lgtm.svc.cluster.local:80/api/v1/write"
  }
}

// --- TRACES ---
otelcol.processor.batch "default" {
  send_batch_size = 1000
  timeout         = "1s"
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "http://tempo.lgtm.svc.cluster.local:4317"
    tls {
      insecure = true
    }
  }
}

// --- LOGS ---
discovery.kubernetes "app_pods" {
  role = "pod"
  namespaces {
    names = ["app"]
  }
}

loki.source.kubernetes "pod_logs" {
  targets    = discovery.kubernetes.app_pods.targets
  forward_to = [loki.process.json_logs.receiver]
}

loki.process "json_logs" {
  stage.json {
    expressions = {
      level = "level",
      cid   = "cid",
      msg   = "message",
    }
  }
  stage.labels {
    values = {
      level = "",
    }
  }
  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// --- PIPELINE ---
otelcol.receiver.otlp.default.output {
  metrics = [otelcol.exporter.prometheus.default.input]
  traces  = [otelcol.processor.batch.default.input]
}

otelcol.processor.batch.default.output {
  traces = [otelcol.exporter.otlp.tempo.input]
}
